PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# At least 32 random characters. Generate one, never reuse the example.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=7d
# Optional: creates an admin account when you run the seed
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
